/*
 * Resource requests by process label.
 *
 * `resourceLimits` caps every request at what this machine actually has, so
 * the same pipeline runs unchanged on a laptop and on a cluster: labels
 * express what a process wants, params express what is available, and the cap
 * reconciles them. An oversized request degrades to the ceiling instead of
 * failing to schedule. (This replaces the older check_max() helper, which
 * Nextflow's current config parser no longer accepts.)
 *
 * Retries target transient failures only. Exit codes 130/137/138/140/143 are
 * what a scheduler sends on out-of-memory or wall-clock kill; those retry with
 * more resources, since `task.attempt` scales the request. Anything else is a
 * real error and stops the run, because silently retrying a genuine bug wastes
 * hours and hides the cause.
 */

process {
    /*
     * A closure, not a plain map. A plain assignment is evaluated when this
     * file is parsed, which happens BEFORE profile configs are merged -- so
     * `-profile test` (max_cpus = 2) would be silently ignored and the
     * top-level default (8) would stand. That is a real failure mode: it
     * surfaces as "Process requirement exceeds available CPUs" on a small
     * machine or CI runner, with nothing pointing at the cause.
     */
    resourceLimits = { [
        cpus  : params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time   as nextflow.util.Duration
    ] }

    cpus   = 1
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in [130,137,138,140,143,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 6 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 12 * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel: process_high_memory {
        cpus   = { 4 * task.attempt }
        memory = { 96.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    // Network-bound: retry more patiently, so one transient SRA outage does
    // not end a cohort-scale run.
    withLabel: process_network {
        cpus          = 2
        memory        = 4.GB
        time          = { 8.h * task.attempt }
        errorStrategy = { task.attempt <= 4 ? 'retry' : 'finish' }
        maxRetries    = 4
    }
}
