/*
 * Resource requests by process label, capped inline to what this machine
 * actually has.
 *
 * Each directive is a closure that compares its own wanted value against
 * params.max_cpus/max_memory/max_time and returns whichever is smaller --
 * so the same pipeline runs unchanged on a laptop and on a cluster: a label
 * expresses what a process wants, --max_* expresses what is available, and
 * the closure reconciles them at task-submission time (not at config-parse
 * time, which matters: -profile test's lower ceiling must still apply after
 * this file is parsed, not be silently overridden by it).
 *
 * This used to be a single `resourceLimits = { [...] }` block at the top of
 * this file (which is the more concise, officially documented way to do
 * this on a current Nextflow) -- reverted after the oldest version this
 * project declares support for and tests in CI, 23.04.0, was found to
 * ignore that directive entirely rather than erroring on it: it parses
 * clean, then simply never caps anything, so a `process_medium` request for
 * 6 cpus goes through uncapped and fails on any runner with fewer, with no
 * indication `resourceLimits` was the reason. Caught by CI itself, on the
 * push that introduced it, not assumed safe from working locally on a
 * newer Nextflow. Per-directive inline capping, by contrast, is just a
 * closure comparing a wanted value against a param -- ordinary DSL2 since
 * its earliest releases, and confirmed to still parse and apply correctly
 * at the 23.04.0 floor.
 *
 * Retries target transient failures only. Exit codes 130/137/138/140/143 are
 * what a scheduler sends on out-of-memory or wall-clock kill; those retry with
 * more resources, since `task.attempt` scales the request. Anything else is a
 * real error and stops the run, because silently retrying a genuine bug wastes
 * hours and hides the cause.
 */

process {
    cpus   = { Math.min(1 * task.attempt, params.max_cpus as int) }
    memory = { def want = 6.GB * task.attempt; def cap = params.max_memory as nextflow.util.MemoryUnit; want > cap ? cap : want }
    time   = { def want = 4.h  * task.attempt; def cap = params.max_time   as nextflow.util.Duration;   want > cap ? cap : want }

    errorStrategy = { task.exitStatus in [130,137,138,140,143,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { Math.min(1 * task.attempt, params.max_cpus as int) }
        memory = { def want = 2.GB * task.attempt; def cap = params.max_memory as nextflow.util.MemoryUnit; want > cap ? cap : want }
        time   = { def want = 2.h  * task.attempt; def cap = params.max_time   as nextflow.util.Duration;   want > cap ? cap : want }
    }
    withLabel: process_low {
        cpus   = { Math.min(2 * task.attempt, params.max_cpus as int) }
        memory = { def want = 4.GB * task.attempt; def cap = params.max_memory as nextflow.util.MemoryUnit; want > cap ? cap : want }
        time   = { def want = 4.h  * task.attempt; def cap = params.max_time   as nextflow.util.Duration;   want > cap ? cap : want }
    }
    withLabel: process_medium {
        cpus   = { Math.min(6 * task.attempt, params.max_cpus as int) }
        memory = { def want = 16.GB * task.attempt; def cap = params.max_memory as nextflow.util.MemoryUnit; want > cap ? cap : want }
        time   = { def want = 8.h   * task.attempt; def cap = params.max_time   as nextflow.util.Duration;   want > cap ? cap : want }
    }
    withLabel: process_high {
        cpus   = { Math.min(12 * task.attempt, params.max_cpus as int) }
        memory = { def want = 48.GB * task.attempt; def cap = params.max_memory as nextflow.util.MemoryUnit; want > cap ? cap : want }
        time   = { def want = 16.h  * task.attempt; def cap = params.max_time   as nextflow.util.Duration;   want > cap ? cap : want }
    }
    withLabel: process_high_memory {
        cpus   = { Math.min(4 * task.attempt, params.max_cpus as int) }
        memory = { def want = 96.GB * task.attempt; def cap = params.max_memory as nextflow.util.MemoryUnit; want > cap ? cap : want }
        time   = { def want = 16.h  * task.attempt; def cap = params.max_time   as nextflow.util.Duration;   want > cap ? cap : want }
    }

    // Network-bound: retry more patiently, so one transient SRA outage does
    // not end a cohort-scale run.
    withLabel: process_network {
        cpus          = { Math.min(2, params.max_cpus as int) }
        memory        = { def cap = params.max_memory as nextflow.util.MemoryUnit; 4.GB > cap ? cap : 4.GB }
        time          = { def want = 8.h * task.attempt; def cap = params.max_time as nextflow.util.Duration; want > cap ? cap : want }
        errorStrategy = { task.attempt <= 4 ? 'retry' : 'finish' }
        maxRetries    = 4
    }
}
