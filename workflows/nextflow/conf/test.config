/*
 * Minimal profile for `-stub-run`: exercises every channel, every join and
 * every file-name expectation in the DAG without a single real tool, real
 * download, or real dataset. This is what CI runs on every push.
 *
 * It is a wiring test, not a correctness test. Scientific correctness is
 * covered by the package's own synthetic-fixture suite (`pytest`), where the
 * expected answer is known by construction.
 */
params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Stub-run settings: tiny inputs, no real tools'

    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'

    samplesheet     = "${projectDir}/assets/samplesheet_test.csv"
    reference       = "${projectDir}/assets/reference_test.fa"
    candidates      = "${projectDir}/assets/candidates_test.csv"
    resistance_gene = 'blaOXA-23'

    skip_amrfinder_update = true
}
