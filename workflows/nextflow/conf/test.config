// Tiny-data CI profile. Used with -stub-run, so no real tools, network
// access, or real sequencing data are needed — this only exercises the
// pipeline's wiring (channels, dependencies, aggregation logic), the same
// philosophy as CLADE's own synthetic-fixture-only Python test suite.
params {
    samplesheet     = "${projectDir}/assets/samplesheet_test.csv"
    reference       = "${projectDir}/assets/reference_test.fa"
    candidates      = "${projectDir}/assets/candidates_test.csv"
    resistance_gene = "geneX"
    outdir          = "test_results"
    max_cpus        = 1
}
