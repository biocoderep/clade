/*
 * Per-process publishing and arguments.
 *
 * Kept out of the module files deliberately: a module should say what a tool
 * does, and the configuration should say where its output goes and with which
 * options. That separation is what lets a user re-point or re-parameterise any
 * step without editing pipeline code.
 */

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
    ]

    withName: 'DOWNLOAD' {
        // Off by default: the reads are already public under their accessions,
        // and re-publishing them can add terabytes to a cohort-scale run.
        publishDir = [ path: { "${params.outdir}/fastq" }, mode: params.publish_dir_mode,
                       enabled: params.save_fastq, pattern: '*.fastq.gz' ]
    }
    withName: 'BUILD_MATRIX' {
        publishDir = [ path: { "${params.outdir}/clade_input" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'DISTANCE_MATRIX' {
        publishDir = [ path: { "${params.outdir}/phylogeny" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'FASTQC_RAW' {
        ext.prefix = { "${meta_id}_raw" }
        publishDir = [ path: { "${params.outdir}/qc/fastqc_raw" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'FASTQC_TRIM' {
        publishDir = [ path: { "${params.outdir}/qc/fastqc_trimmed" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'FASTP' {
        // --detect_adapter_for_pe: the cohort spans many BioProjects and
        // library preps; a single hard-coded adapter would be wrong for most.
        ext.args = '--detect_adapter_for_pe'
        publishDir = [
            [ path: { "${params.outdir}/qc/fastp" }, mode: params.publish_dir_mode, pattern: '*.{json,html}' ],
            [ path: { "${params.outdir}/trimmed"  }, mode: params.publish_dir_mode, pattern: '*.fastq.gz',
              enabled: params.save_trimmed ]
        ]
    }
    withName: 'MULTIQC' {
        publishDir = [ path: { "${params.outdir}/qc/multiqc" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'SNIPPY' {
        publishDir = [ path: { "${params.outdir}/variants/per_sample" }, mode: params.publish_dir_mode,
                       enabled: params.save_snippy_dirs,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'SNIPPY_CORE' {
        publishDir = [ path: { "${params.outdir}/variants/core" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'SHOVILL' {
        publishDir = [ path: { "${params.outdir}/assemblies" }, mode: params.publish_dir_mode,
                       enabled: params.save_assemblies,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'FASTTREE' {
        publishDir = [ path: { "${params.outdir}/phylogeny" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'RUN_CLADE' {
        publishDir = [ path: { "${params.outdir}/clade" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COLLATE_VERSIONS' {
        publishDir = [ path: { "${params.outdir}/pipeline_info" }, mode: params.publish_dir_mode ]
    }
}
