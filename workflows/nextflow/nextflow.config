params {
    samplesheet     = null
    reference       = null
    candidates      = null
    resistance_gene = null
    outdir          = "results"
    max_cpus        = 4
}

process {
    // Closure, not a plain assignment: params.max_cpus must be read at
    // process-submission time, not config-parse time. The `test` profile's
    // override (conf/test.config, max_cpus = 1) is merged in after this
    // block in file order, so a plain `cpus = params.max_cpus` would lock
    // in the top-level default (4) before the profile override ever
    // applies -- this was a real CI failure (req: 4; avail: 2 on the
    // GitHub Actions runner) caused by exactly that ordering.
    cpus = { params.max_cpus }
    errorStrategy = 'terminate'
}

// conda is intentionally NOT enabled by default — only under `-profile conda`.
// -stub-run must work with zero real tools installed; if conda.enabled were
// on globally, Nextflow tries to resolve/build every process's environment
// even for a stub run (this was a real bug caught while first running
// -stub-run: pinned exact versions of snippy/vcflib/htslib/samtools/
// perl-bioperl hit a genuine channel dependency conflict that has nothing to
// do with pipeline logic, and blocked the stub run entirely).
profiles {
    conda {
        conda.enabled = true
        conda.useMamba = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}

manifest {
    name = 'clade-pipeline'
    description = 'Raw reads to CLADE six-stage evidence table'
    homePage = 'https://github.com/biocoderep/clade'
    mainScript = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version = '0.1.0'
}
