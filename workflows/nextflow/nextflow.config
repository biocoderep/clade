/*
 * CLADE pipeline configuration.
 *
 * Reproducibility contract: every tool is pinned to an exact version, and
 * every version is available as a signed BioContainer image (verified against
 * quay.io). The conda environment pins the same versions, so `-profile conda`
 * and `-profile docker` run the same software. Nothing here resolves to
 * "latest".
 */

params {
    // --- alternate entry: resume from an already-extracted genotype matrix,
    //     skipping raw-read genome processing entirely -----------------------
    from_matrix       = false
    matrix_genotypes  = null   // Sample_ID-indexed CSV, one 0/1 column per candidate
    matrix_phenotype  = null   // sample<TAB>phenotype TSV
    matrix_lineages   = null   // sample<TAB>ST TSV
    matrix_candidates = null   // name,position CSV (position unused in this mode)
    matrix_tree       = null   // Newick phylogeny
    matrix_distances  = null   // sample x sample patristic distance TSV

    // --- required inputs (raw-reads mode) -----------------------------------
    samplesheet     = null   // CSV: sample_id,accession  OR  sample_id,fastq_1,fastq_2
    reference       = null   // reference genome FASTA
    candidates      = null   // CSV: name,position  (1-based, on the reference)
    resistance_gene = null   // AMRFinderPlus gene symbol defining the phenotype

    // --- tool options ------------------------------------------------------
    abricate_db = 'ncbi'

    /*
     * Container holding the `clade` package and its Python dependencies, used
     * by the three pipeline-specific steps. Built from containers/Dockerfile
     * in this repository and published by CI on every tagged release, so the
     * tag below always corresponds to a real, immutable image.
     */
    clade_container = 'ghcr.io/biocoderep/clade:1.0.0'

    // --- CLADE stage options ----------------------------------------------
    alpha                = 0.05
    min_carriers         = 5
    max_freq             = 0.85
    temporal_margin      = 0.0
    ambiguity_resolution = 0      // 0 = DELTRAN-like, 1 = ACCTRAN-like
    unique_neighbors     = false
    stage1_results       = null   // optional: externally computed (e.g. pyseer) Stage 1
    stage6               = null   // optional: JSON of manual corroboration findings

    // --- optional deeper validation (all off by default; each is materially
    //     slower than the core RUN_CLADE step, since each re-fits many
    //     candidates rather than reading one evidence table) ---------------
    run_stage5_conditional  = false  // Stage 5 via conditional logistic regression,
                                     // stratified on the matched control genome --
                                     // use when matched-neighbour reuse is high
                                     // (RUN_CLADE's own McNemar path warns when it is)
    run_fwer_permutation    = false  // lineage-preserving permutation estimate of the
                                     // whole six-stage screen's family-wise error rate
    fwer_n_permutations     = 100
    fwer_seed               = 0
    run_benchmark            = false // compare CLADE's dispositions against a
                                     // conventional single-test pipeline (classical
                                     // MDS of the distance matrix + logistic
                                     // regression + BH-FDR -- pyseer's fixed-effects
                                     // distance model, reimplemented; see
                                     // bin/benchmark_single_test.py)
    benchmark_mds_dimensions = 10

    // --- output ------------------------------------------------------------
    outdir            = 'results'
    publish_dir_mode  = 'copy'
    save_fastq        = false   // raw downloads; terabytes at cohort scale
    save_trimmed      = false
    save_assemblies   = true
    save_snippy_dirs  = false

    // --- skip switches -----------------------------------------------------
    skip_fastqc           = false
    skip_multiqc          = false
    skip_amrfinder_update = false

    // --- resource ceilings (what THIS machine has) -------------------------
    max_cpus   = 8
    max_memory = '32.GB'
    max_time   = '48.h'

    // --- misc --------------------------------------------------------------
    help    = false
    version = false
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    /*
     * Container profiles. Prefer these over conda: an image is a fixed
     * filesystem, whereas a conda solve can drift as channels change even with
     * pinned versions.
     */
    docker {
        docker.enabled       = true
        docker.runOptions    = '-u $(id -u):$(id -g)'
        singularity.enabled  = false
        apptainer.enabled    = false
        conda.enabled        = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
        singularity.enabled  = false
        conda.enabled        = false
    }
    podman {
        podman.enabled      = true
        docker.enabled      = false
        conda.enabled       = false
    }

    /*
     * Conda is the fallback for environments where containers are not
     * permitted (some HPC estates). Deliberately NOT enabled by default:
     * with conda on globally, `-stub-run` still tries to solve every
     * environment, which turns a five-second wiring check into a long
     * dependency resolution that can fail for reasons unrelated to the
     * pipeline.
     */
    conda {
        conda.enabled  = true
        conda.channels = ['conda-forge', 'bioconda', 'defaults']
        docker.enabled = false
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
        docker.enabled = false
    }

    test { includeConfig 'conf/test.config' }

    // Convenience for local multi-core workstations.
    local {
        executor.name       = 'local'
        executor.cpus       = params.max_cpus
        executor.memory     = params.max_memory
    }
    slurm {
        process.executor    = 'slurm'
        executor.queueSize  = 100
    }
}

// Prevent a host Python/Perl/R from leaking into containerised tasks.
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = '/.Rprofile'
    R_ENVIRON_USER   = '/.Renviron'
}

// Run provenance. Each report carries the run name, so repeated runs into the
// same --outdir do not silently overwrite one another's evidence.
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/execution_report.html"   }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/execution_trace.txt"     }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/execution_timeline.html" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/pipeline_dag.html"       }

manifest {
    name            = 'biocoderep/clade'
    author          = 'Pooja B. N.'
    homePage        = 'https://github.com/biocoderep/clade'
    description     = 'CLADE: lineage-aware validation of candidate compensatory mutations in clonal bacterial populations'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
    license         = 'MIT'
}

/*
 * Completion handler. Lives here rather than in main.nf because the current
 * Nextflow parser treats a top-level `workflow.onComplete { }` in a script as
 * a loose statement; config event handlers are the supported home for it.
 */
workflow.onComplete = {
    // `log` is not available in config scope (it is null here), so this uses
    // println. Discovered by the handler throwing NullPointerException on the
    // first real run rather than by assumption.
    def status = workflow.success ? 'Completed' : 'FAILED'
    println ""
    println "----------------------------------------------------------------"
    println " ${status} -- ${workflow.runName}  (${workflow.duration})"
    println " results  : ${params.outdir}"
    println " evidence : ${params.outdir}/clade/clade_evidence_table.md"
    println " versions : ${params.outdir}/pipeline_info/software_versions.yml"
    println "----------------------------------------------------------------"
    if (!workflow.success) {
        println " The failing task's work directory holds .command.sh (what ran)"
        println " and .command.err (why it failed)."
    }
}
